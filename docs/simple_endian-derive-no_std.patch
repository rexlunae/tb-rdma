diff --git a/src/lib.rs b/src/lib.rs
index 0e8a45a..778ff33 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -185,6 +185,24 @@ pub use shorthand_types_nonzero::*;
 #[cfg(feature = "derive")]
 pub use simple_endian_derive::Endianize;
 
+/// Implementation detail of `#[derive(Endianize)]`: expands to its input when the
+/// `io-std` feature is enabled and to nothing otherwise, so derived wire types still
+/// compile in `no_std` builds (the generated `EndianRead`/`EndianWrite` impls need
+/// `std::io`). The cfg is evaluated here, in this crate, not in the user's crate.
+#[cfg(feature = "io-std")]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! __endianize_io {
+    ($($t:tt)*) => { $($t)* };
+}
+
+#[cfg(not(feature = "io-std"))]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! __endianize_io {
+    ($($t:tt)*) => {};
+}
+
 /// Optional IO helpers gated by the `io` feature.
 #[cfg(any(feature = "io-core", feature = "io-std"))]
 mod io;
diff --git a/tests/derive_no_std.rs b/tests/derive_no_std.rs
new file mode 100644
index 0000000..41d2b93
--- /dev/null
+++ b/tests/derive_no_std.rs
@@ -0,0 +1,24 @@
+// Derived wire types must compile and convert without `io-std` (no `std::io`).
+#![cfg(all(feature = "derive", not(feature = "io-std")))]
+
+use simple_endian::Endianize;
+
+#[derive(Endianize, Clone, Copy)]
+#[endian(le)]
+#[repr(C, packed)]
+#[wire_repr(C, packed)]
+#[wire_derive(Clone, Copy)]
+struct Hdr {
+    a: u8,
+    b: u16,
+    c: u32,
+}
+
+#[test]
+fn derive_without_io_std() {
+    let w = HdrWire::from(Hdr { a: 1, b: 0x0203, c: 0x0405_0607 });
+    assert_eq!(core::mem::size_of::<HdrWire>(), 7);
+    let n = Hdr::from(w);
+    let (a, b, c) = (n.a, n.b, n.c);
+    assert_eq!((a, b, c), (1, 0x0203, 0x0405_0607));
+}
